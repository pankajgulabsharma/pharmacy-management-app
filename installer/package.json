{
  "name": "medicare-pharmacy",
  "productName": "MediCare Pharmacy",
  "version": "1.0.0",
  "private": true,
  "description": "MediCare Pharmacy — billing, stock, purchases and udhaar for a medical shop",
  "author": "MediCare",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "npm run bundle && electron .",
    "dist": "npm run bundle && electron-builder --win nsis --x64",
    "dist:dir": "npm run bundle && electron-builder --win dir --x64",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "0.28.2",
    "typescript": "~6.0.2"
  }
}
