{
  "name": "@medicare/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Local server: owns the database and applies the shop's rules",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@medicare/demo": "*",
    "@medicare/domain": "*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
